<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: recently used devices appear right in the system share menu. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.crossdrop.share.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.crossdrop.SHARE_TARGET" />
    </share-target>
</shortcuts>
